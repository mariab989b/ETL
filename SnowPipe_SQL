USE ROLE INGEST;
USE DATABASE INGEST;
USE SCHEMA INGEST;

-- Table for Maison Albert merchandise orders
CREATE OR REPLACE TABLE CLIENT_SUPPORT_ORDERS_PY_SNOWPIPE (
  -- Identifiants techniques & produit
  TXID                 STRING,
  RFID                 STRING,
  PRODUCT_ID           STRING,
  PRODUCT_VARIANT_ID   STRING,

  -- Produit & catalogue
  ITEM                 STRING,
  SIZE                 STRING,              -- ex: '30ml' / '100ml'
  CATEGORY             STRING,              -- floral / woody / spicy / sweet / fresh / amber
  GENDER               STRING,              -- 'm' | 'f' | 'u'
  SUB_CATEGORY         STRING,              -- woody / spicy / sweet / fresh / amber / floral
  PRICE                NUMBER(12,2),        -- EUR (nombre, 2 décimales)

  -- Temps (achat avec TZ ; livraison/expiration en DATE)
  PURCHASE_TIME        TIMESTAMP_TZ,
  DELIVERY_TIME        DATE,
  EXPIRATION_TIME      DATE,

  -- Jour de la semaine d'achat (1 = lundi … 7 = dimanche)
  DAYS                 NUMBER(1,0),

  -- Remboursement & avis
  REFUNDED             BOOLEAN,
  REFUND_REASON        STRING,
  REVIEW_SCORE         NUMBER(1,0),         -- 1..5
  REVIEW_TEXT          STRING,

  -- Client (adresse aplatie)
  NAME                 STRING,
  ADDRESS_STREET       STRING,
  ADDRESS_CITY         STRING,
  ADDRESS_POSTALCODE   STRING,
  PHONE                STRING,
  EMAIL                STRING,
  DATE_OF_BIRTH        DATE,
  SEX                  STRING 
  );

CREATE OR REPLACE PIPE CLIENT_SUPPORT_ORDERS_PIPE AS 
COPY INTO CLIENT_SUPPORT_ORDERS_PY_SNOWPIPE
FILE_FORMAT=(TYPE='PARQUET') 
MATCH_BY_COLUMN_NAME=CASE_SENSITIVE;
