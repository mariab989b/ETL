USE ROLE INGEST;

-- Table for Maison Albert merchandise orders
CREATE OR REPLACE TABLE CLIENT_SUPPORT_ORDERS_PY_SNOWPIPE (
    TXID VARCHAR(255) NOT NULL,
    RFID VARCHAR(255) NOT NULL,  
    ITEM VARCHAR(255) NOT NULL,
    SIZE VARCHAR(255) NOT NULL,
    CATEGORY VARCHAR(255) nOT NULL,
    GENDER VARCHAR(255) NOT NULL,
    SUB_CATEGORY VARCHAR(255) NOT NULL,
    PRICE DECIMAL(10, 2) NOT NULL,
    PURCHASE_TIME TIMESTAMP NOT NULL,
    DELIVERY_TIME TIMESTAMP NOT NULL,
    EXPIRATION_TIME DATE NOT NULL,
    DAYS NUMBER NOT NULL,
    REFUNDED BOOLEAN NOT NULL,
    REFUND_REASON VARCHAR(255) NOT NULL,
    REVIEW_TEXT VARCHAR(255) NOT NULL,
    NAME VARCHAR(255) NOT NULL,
    ADDRESS VARIANT,                     
    PHONE VARCHAR(255),                  
    EMAIL VARCHAR(255),                  
    EMERGENCY_CONTACT VARIANT,           
    PRIMARY KEY (TXID)
);

CREATE OR REPLACE PIPE CLIENT_SUPPORT_ORDERS_PIPE AS 
COPY INTO CLIENT_SUPPORT_ORDERS_PY_SNOWPIPE
FILE_FORMAT=(TYPE='PARQUET') 
MATCH_BY_COLUMN_NAME=CASE_SENSITIVE;

-- Add comments for clarity
COMMENT ON TABLE CLIENT_SUPPORT_ORDERS IS 'Customer orders for Maison Albert inventory';
COMMENT ON COLUMN CLIENT_SUPPORT_ORDERS.ITEM IS 'Product from Maison Albert inventory';
COMMENT ON COLUMN CLIENT_SUPPORT_ORDERS.ADDRESS IS 'JSON: {street_address, city, state, postalcode} or NULL';
COMMENT ON COLUMN CLIENT_SUPPORT_ORDERS.EMERGENCY_CONTACT IS 'JSON: {name, phone} or NULL';
COMMENT ON COLUMN CLIENT_SUPPORT_ORDERS.SIZE IS 'Either 100 or 30ml';
COMMENT ON COLUMN CLIENT_SUPPORT_ORDERS.REFUNDED IS 'Boolean if the order was refunded, reason is explained at the refund_column';
